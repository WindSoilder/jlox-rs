def say_hi(first, last) {
    print "Hi, " + first + " " + last + "!";
}

say_hi("Dear", "Reader");

def fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

for (var i = 0; i < 20; i = i + 1) {
  print fib(i);
}
